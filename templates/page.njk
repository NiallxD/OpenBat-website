---
layout: base.njk
---
{% block head %}
{% if 'gallery-start' in content %}<link rel="stylesheet" href="{{ '/static/css/swiper-bundle.min.css' | url }}"/>{% endif %}
{% endblock %}
<div class="standard-page">
  {% if sectionLabel %}
  <p class="section-label">{{ sectionLabel }}</p>
  {% endif %}

  {% if title %}
  <div class="listing-header">
    <h1>{{ title }}</h1>
    {% if description %}<p class="page-lead">{{ description }}</p>{% endif %}
  </div>
  {% endif %}

  {# Cards by default; `cards: false` in the frontmatter opts a page out, for
     pages that lay themselves out (the guide editor, the image examples). #}
  <div class="post-content{% if cards === false %} post-content--plain{% else %} page-cards{% endif %}">
    {%- if cards === false -%}
      {{ content | safe }}
    {%- else -%}
      {{ content | sectionCards | safe }}
    {%- endif -%}
  </div>
  {% if 'gallery-start' in content %}<script src="{{ '/static/js/swiper-bundle.min.js' | url }}"></script>{% endif %}
</div>
