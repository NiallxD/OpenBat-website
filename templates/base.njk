<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title and page.url != '/' %}{{ title }} — {% endif %}{{ site.name }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <!-- Privacy & Security -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://raw.githubusercontent.com https://api.openbat.app; base-uri 'self'; form-action 'self'; frame-ancestors 'none';">
  <meta name="referrer" content="no-referrer">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{% if title and page.url != '/' %}{{ title }} — {% endif %}{{ site.name }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  {% if coverImage %}<meta property="og:image" content="{{ coverImage }}">{% endif %}
  <link rel="preload" href="{{ '/static/fonts/jersey10.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/static/fonts/geist-pixel.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <!-- Favicons -->
  <link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="32x32">
  <link rel="icon" href="{{ '/static/images/favicon-32.png' | url }}" type="image/png" sizes="32x32">
  <link rel="icon" href="{{ '/static/images/favicon-16.png' | url }}" type="image/png" sizes="16x16">
  <link rel="apple-touch-icon" href="{{ '/static/images/apple-touch-icon.png' | url }}">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)">
  <link rel="stylesheet" href="{{ '/static/css/style.css?v=3.6' | url }}">
  <script>
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme !== 'light') {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  </script>
  {% block head %}{% endblock %}
</head>
<body>
  <header class="site-header transparent-header">
    <div class="site-header-inner">
      <a class="site-title" href="{{ '/' | url }}">
        <img class="site-logo" src="{{ '/static/images/logo.png' | url }}" alt="{{ site.name }}">
      </a>
      <nav class="nav-menu">
        {% for item in site.nav %}
        <a href="{{ item.url | url }}"{% if page.url == item.url %} class="active"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>
      <div class="header-controls">
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
          <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <button id="menu-toggle" class="menu-toggle" aria-label="Toggle menu">
          <svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          <svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
    </div>
  </header>
  <div class="nav-overlay"></div>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <div class="footer-col brand">
        <a class="footer-logo-link" href="{{ '/' | url }}">
          <img class="footer-logo" src="{{ '/static/images/logo.png' | url }}" alt="{{ site.name }}">
        </a>
        <p class="footer-web-address">{{ site.domain }}</p>
        <div class="footer-contact">
          <div class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span class="reveal-email" data-u="{{ site.email.user }}" data-d="{{ site.email.domain }}" style="cursor:pointer;">Click to reveal email</span>
          </div>
        </div>
        <p class="footer-privacy-link"><a href="{{ '/privacy/' | url }}">Privacy</a></p>
      </div>
    </div>
    <p class="footer-copyright">© {{ "" | year }} Niall Bell ({{ site.name }})</p>
  </footer>

  <script>
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const target = current === 'dark' ? 'light' : 'dark';
      const applyTheme = () => {
        document.documentElement.setAttribute('data-theme', target);
        localStorage.setItem('theme', target);
      };
      if (document.startViewTransition) {
        document.startViewTransition(applyTheme);
      } else {
        applyTheme();
      }
    });

    const menuToggle = document.getElementById('menu-toggle');
    const navOverlay = document.querySelector('.nav-overlay');
    const body = document.body;

    const toggleMenu = () => {
      const isOpen = body.classList.toggle('menu-open');
      menuToggle.setAttribute('aria-expanded', isOpen);
    };

    menuToggle.addEventListener('click', toggleMenu);
    navOverlay.addEventListener('click', toggleMenu);

    // Close menu when a link is clicked
    document.querySelectorAll('.nav-menu a').forEach(link => {
      link.addEventListener('click', () => {
        if (body.classList.contains('menu-open')) toggleMenu();
      });
    });

    const header = document.querySelector('.site-header');
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 10);
    };
    window.addEventListener('scroll', onScroll);
    onScroll();

    // Platform toggle (Help page) — swap the iOS / Android panels
    const platBtns = document.querySelectorAll('.plat-toggle-btn');
    if (platBtns.length) {
      const platSections = {
        ios: document.getElementById('plat-ios'),
        android: document.getElementById('plat-android'),
      };

      const setPlatform = (mode, instant) => {
        const incoming = platSections[mode];
        const outgoing = platSections[mode === 'ios' ? 'android' : 'ios'];
        if (!incoming || !outgoing) return;

        platBtns.forEach(btn => {
          const on = btn.dataset.platform === mode;
          btn.classList.toggle('active', on);
          btn.setAttribute('aria-selected', on);
        });

        if (instant) {
          outgoing.classList.add('plat-hidden');
          incoming.classList.remove('plat-hidden');
          return;
        }

        // Fade the outgoing panel out, swap, then fade the incoming one in
        outgoing.style.opacity = '0';
        setTimeout(() => {
          outgoing.classList.add('plat-hidden');
          outgoing.style.opacity = '';
          incoming.classList.remove('plat-hidden');
          incoming.style.transition = 'none';
          incoming.style.opacity = '0';
          incoming.getBoundingClientRect(); // force reflow
          incoming.style.transition = '';
          incoming.style.opacity = '1';
        }, 350);
      };

      platBtns.forEach(btn => {
        btn.addEventListener('click', () => setPlatform(btn.dataset.platform));
      });

      if (location.hash === '#android') setPlatform('android', true);
    }

    // Assemble obfuscated email addresses on click
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.reveal-email').forEach(el => {
        el.addEventListener('click', () => {
          const email = el.dataset.u + '@' + el.dataset.d;
          const cls = el.className.replace('reveal-email', '').trim();
          const inner = el.querySelector('svg')
            ? el.querySelector('svg').outerHTML + email
            : email;
          const style = el.getAttribute('style') || '';
          el.outerHTML = `<a href="mailto:${email}" class="${cls}" style="${style}">${inner}</a>`;
        });
      });
    });
  </script>
</body>
</html>
