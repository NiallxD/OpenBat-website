{# Featured-post ticker: up to three cards, auto-advancing, with position
   dots. Shared by home.njk and blog.njk — both set `hero` to
   collections.heroPosts before including this. The script that drives it
   lives once in base.njk and runs over every [data-ticker] on the page. #}
<div class="hero-ticker" data-ticker>
  <div class="hero-ticker-track">
    {% for post in hero %}
    <a href="{{ post.url | url }}" class="post-card post-card--featured hero-ticker-slide">
      {% if post.data.coverImage %}
      <div class="post-card-img">
        <img src="{{ post.data.coverImage }}" alt="" loading="lazy">
      </div>
      {% endif %}
      <div class="post-card-body">
        <p class="section-label">{{ "Featured" if post.data.featured === true else "Latest" }}</p>
        <h2>{{ post.data.title }}</h2>
        <div class="post-card-meta">
          {% if post.date %}<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>{% endif %}
          {% for tag in post.data.tags | limit(3) %}<span class="tag">{{ tag }}</span>{% endfor %}
        </div>
        <p class="post-card-desc">{{ post.data.excerpt | default(post.data.description) | default(post.templateContent | autoExcerpt) }}</p>
      </div>
    </a>
    {% endfor %}
  </div>
</div>
{% if hero.length > 1 %}
<div class="hero-ticker-dots" role="tablist" aria-label="Featured posts">
  {% for post in hero %}
  <button type="button" class="hero-ticker-dot" data-index="{{ loop.index0 }}" role="tab" aria-label="Show featured post {{ loop.index }} of {{ hero.length }}"></button>
  {% endfor %}
</div>
{% endif %}
