{# The app lockup: icon, name, one line of pitch, the App Store badge, and the
   screenshot dock under it. Shared by the home page and /download/, so the
   two cannot drift — edit the copy here once.

   The dock itself is `partials/app-dock.njk`, included below, which carries
   its own per-screen captions.

   `.app-lockup` exists only to hold the space above the icon. Both pages want
   the icon clear of the transparent nav rather than tucked under it, and
   putting that on the shared wrapper means neither page can forget it. #}
<div class="app-lockup">

  <img class="app-landing-icon" src="/static/images/openbat-logo-rounded.webp" alt="The OpenBat app icon: pixel-art lettering over a starry night sky, with a bat hanging beside it">

  <h1 class="app-landing-title">OpenBat</h1>

  <p class="app-landing-tagline">Turn your iPhone into a bat detector.</p>

  <a class="appstore-badge" href="https://apps.apple.com/gb/app/openbat/id6787886621" aria-label="Download OpenBat on the App Store">
    <svg class="appstore-badge-icon" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.18 8.34c-.02-1.72 1.4-2.55 1.47-2.59-.8-1.17-2.05-1.33-2.49-1.35-1.06-.11-2.07.62-2.6.62-.54 0-1.36-.61-2.24-.59-1.15.02-2.21.67-2.8 1.7-1.19 2.07-.3 5.13.86 6.81.57.82 1.25 1.74 2.14 1.71.86-.04 1.19-.56 2.23-.56s1.33.56 2.24.54c.93-.02 1.51-.84 2.08-1.66.65-.95.92-1.87.94-1.92-.02-.01-1.8-.69-1.83-2.74ZM9.47 3.28c.47-.58.79-1.37.7-2.17-.68.03-1.5.45-1.99 1.02-.44.51-.82 1.32-.72 2.09.76.06 1.53-.38 2.01-.94Z"/></svg>
    <span class="appstore-badge-text">
      <span class="appstore-badge-small">Download on the</span>
      <span class="appstore-badge-large">App Store</span>
    </span>
  </a>

  <div class="app-landing-dock">
  {% include "partials/app-dock.njk" %}
  </div>

</div>
