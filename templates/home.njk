---
layout: base.njk
---
{% block head %}
{% if 'gallery-start' in content %}<link rel="stylesheet" href="{{ '/static/css/swiper-bundle.min.css' | url }}"/>{% endif %}
{% endblock %}
{# Optional dark hero; without heroTitle/heroImage the page keeps the plain
   page.njk header instead. #}
{% if heroTitle or heroImage %}
<div class="hero-plain">
  {% if heroImage %}
  <img src="{{ heroImage }}" alt="" class="hero-plain-bg">
  {% endif %}
  <div class="hero-plain-inner">
    <h1 class="hero-plain-title">{{ heroTitle | default(title) }}</h1>
    {% if heroText %}<p class="hero-plain-text">{{ heroText }}</p>{% endif %}
    {% if heroCtaUrl %}
    <a class="hero-plain-cta" href="{{ heroCtaUrl | url }}">{{ heroCtaLabel | default("Learn more") }}</a>
    {% endif %}
  </div>
</div>
{% endif %}

<div class="standard-page">
  {% if not (heroTitle or heroImage) and title %}
  <div class="listing-header listing-header--home">
    <h1>{{ title }}</h1>
    {% if description %}<p class="page-lead">{{ description }}</p>{% endif %}
  </div>
  {% endif %}

  {# The same featured ticker that heads /blog/, sitting under the page title.
     Both read collections.heroPosts and share the ticker markup/script in
     base.njk — keep the two in step. #}
  {% set hero = collections.heroPosts %}
  {% if hero.length %}
  <div class="home-featured">
    {% include "partials/hero-ticker.njk" %}
  </div>
  {% endif %}

  {# App screenshots as a macOS-style dock: hovering one magnifies it, dims
     the rest of the row, and drops its blurb into the shared caption slot
     below. Captions live in this array — add or reorder entries here. #}
  {% set screens = [
    { img: "screen-detector.webp", title: "Live detector",
      text: "A real-time spectrogram, pulse statistics and on-device species suggestions while the bats are still flying." },
    { img: "screen-globe.webp", title: "Explore the globe",
      text: "The field guide as a spinning globe — open any region to see which bats live there." },
    { img: "screen-region-list.webp", title: "Bats near you",
      text: "Every species in your region, illustrated, so you know who shares your patch of sky." },
    { img: "screen-species-profile.webp", title: "Species profiles",
      text: "Calls, measurements, true size and conservation status, written and checked by the community." },
    { img: "screen-range-map.webp", title: "Range maps",
      text: "Distribution built from GBIF records, showing where a species has actually been recorded." },
    { img: "screen-call-analysis.webp", title: "Call analysis",
      text: "Go back over a recording afterwards — measure a pulse, zoom into the sweep, and hear it slowed down." }
  ] %}
  <h2 class="home-section-title">The App</h2>
  <section class="dock-section" aria-label="What OpenBat does">
   {# The two wrappers do nothing on desktop. On a phone the script turns them
      into a pinned stage: `.dock-scroll` supplies the scroll runway and
      `.dock-sticky` holds the row still while the screens slide through it. #}
   <div class="dock-scrim" aria-hidden="true"></div>
   <div class="dock-scroll">
    <div class="dock-sticky">
    <div class="dock">
      {% for s in screens %}
      <figure class="dock-item">
        <span class="dock-shot">
          <img src="{{ ('/static/images/' + s.img) | url }}" alt="{{ s.title }}"
               width="620" height="1344" loading="lazy" decoding="async">
        </span>
        <figcaption class="dock-caption">
          <span class="dock-caption-title">{{ s.title }}</span>
          <span class="dock-caption-text">{{ s.text }}</span>
        </figcaption>
      </figure>
      {% endfor %}
      <p class="dock-hint">Hover a screen to see what it does</p>
    </div>
    </div>
   </div>
  </section>

  <script>
    // Continuous dock magnification. The CSS :hover rules are a fallback for
    // no-JS; once this runs it adds `dock--js`, which switches them off and
    // sizes every screen from its distance to the pointer instead. That is
    // what stops the row snapping between states as the cursor crosses a
    // boundary — and the sideways offsets keep a magnified screen from
    // sliding out from under the pointer, which was the other source of jump.
    (() => {
      const dock = document.querySelector('.dock');
      if (!dock) return;
      const items = [...dock.querySelectorAll('.dock-item')];
      if (!items.length) return;

      const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)');
      const wide = window.matchMedia('(min-width: 801px)');
      const on = () => fine.matches && wide.matches && !still.matches;

      const MAG = 0.30;   // peak growth, at the pointer
      const SPREAD = 1.5; // falloff in item-widths

      const shots = items.map(i => i.querySelector('.dock-shot'));
      const scrim = document.querySelector('.dock-scrim');
      let frame = 0, active = -1;

      const reset = () => {
        shots.forEach(s => { s.style.transform = ''; s.style.opacity = ''; s.style.filter = ''; s.style.zIndex = ''; });
        items.forEach(i => i.classList.remove('is-active'));
        if (scrim) scrim.style.opacity = '';
        dock.classList.remove('is-hovered');
        active = -1;
      };

      // Untransformed geometry. offsetLeft/offsetWidth ignore transforms, so
      // reading them cannot feed the magnification back into itself the way
      // getBoundingClientRect() would — that feedback is what makes a dock
      // like this shudder.
      const layout = (clientX) => {
        const origin = dock.getBoundingClientRect().left;
        const pointerX = clientX - origin;
        const width = items[0].offsetWidth || 1;
        // Gaussian falloff: nearest screen grows most, its neighbours less,
        // and everything tapers to nothing rather than stopping abruptly.
        const grow = items.map(i => {
          const d = (pointerX - (i.offsetLeft + i.offsetWidth / 2)) / (width * SPREAD);
          return MAG * Math.exp(-d * d);
        });

        let nearest = 0;
        grow.forEach((g, i) => { if (g > grow[nearest]) nearest = i; });

        // Push each screen aside by half of what its neighbours gained, so the
        // row spreads instead of overlapping.
        const offset = grow.map((_, i) => {
          let shift = 0;
          for (let j = 0; j < i; j++) shift += grow[j] * width;
          for (let j = i + 1; j < grow.length; j++) shift -= grow[j] * width;
          return shift / 2;
        });

        // Keep the spread inside the window. Rather than clipping the outermost
        // screens, nudge the whole row back by however far it would have
        // spilled — the way the macOS dock stays on screen — so magnification
        // stays even everywhere along the row. The room to spread into is the
        // window either side of the row, not just the text column, since the
        // page margins are empty.
        const room = Math.max(0, (document.documentElement.clientWidth - dock.clientWidth) / 2 - 8);
        let minLeft = Infinity, maxRight = -Infinity;
        items.forEach((item, i) => {
          const centre = item.offsetLeft + item.offsetWidth / 2 + offset[i];
          const half = (item.offsetWidth * (1 + grow[i])) / 2;
          minLeft = Math.min(minLeft, centre - half);
          maxRight = Math.max(maxRight, centre + half);
        });
        // Correcting one edge can push the other out, so handle both: if the
        // magnified row simply will not fit, centre the spill instead of
        // pinning it to a side — that lopsidedness was the bug here.
        const span = maxRight - minLeft;
        const fits = span <= dock.clientWidth + room * 2;
        let nudge;
        if (!fits) {
          nudge = dock.clientWidth / 2 - (minLeft + maxRight) / 2;
        } else {
          nudge = 0;
          if (minLeft + nudge < -room) nudge = -room - minLeft;
          if (maxRight + nudge > dock.clientWidth + room) nudge = dock.clientWidth + room - maxRight;
        }

        grow.forEach((g, i) => {
          const prox = g / MAG;
          const s = shots[i];
          s.style.transform = `translateX(${(offset[i] + nudge).toFixed(2)}px) scale(${(1 + g).toFixed(4)})`;
          s.style.opacity = (0.42 + 0.58 * prox).toFixed(3);
          s.style.filter = `saturate(${(0.5 + 0.5 * prox).toFixed(3)})`;
          s.style.zIndex = String(Math.round(prox * 10));
        });

        // The whole page dims behind the row, by as much as the nearest screen
        // is magnified — so it deepens and lifts with the pointer rather than
        // switching on.
        if (scrim) scrim.style.opacity = (0.62 * (grow[nearest] / MAG)).toFixed(3);

        if (nearest !== active) {
          items.forEach((it, i) => it.classList.toggle('is-active', i === nearest));
          active = nearest;
        }
      };

      let pointerX = 0;
      dock.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse' || !on()) return;
        dock.classList.add('is-hovered');
        pointerX = e.clientX;                 // always the newest position,
        if (frame) return;                    // one layout per frame
        frame = requestAnimationFrame(() => { frame = 0; layout(pointerX); });
      });

      dock.addEventListener('pointerleave', () => {
        if (frame) { cancelAnimationFrame(frame); frame = 0; }
        reset();
      });

      // ── Phone: the row becomes a pinned stage ────────────────────────
      // `.dock-scroll` is made tall enough to hold the page in place for a
      // few screenfuls; `.dock-sticky` pins the row while that scrolls past,
      // and the progress through it slides the screens right to left. Each
      // one grows as it reaches the middle and shrinks as it leaves, which is
      // the desktop magnification driven by scroll instead of a pointer.
      const section = dock.closest('.dock-section');
      const scroller = dock.closest('.dock-scroll');
      const sticky = dock.closest('.dock-sticky');
      const small = window.matchMedia('(max-width: 800px)');
      const pinnable = () => small.matches && !still.matches;

      let pinFrame = 0;

      const pinLayout = () => {
        const runway = scroller.offsetHeight - sticky.offsetHeight;
        if (runway <= 0) return;
        const top = scroller.getBoundingClientRect().top;
        const p = Math.min(1, Math.max(0, -top / runway));

        const w = items[0].offsetWidth || 1;
        const step = items.length > 1 ? items[1].offsetLeft - items[0].offsetLeft : w;
        const stage = sticky.clientWidth;
        // Centre the first screen at the start, the last one at the end.
        const slide = (stage - w) / 2 - p * (items.length - 1) * step;

        let nearest = 0, best = Infinity;
        items.forEach((item, i) => {
          const centre = item.offsetLeft + w / 2 + slide;
          const d = (centre - stage / 2) / w;
          const prox = Math.exp(-d * d);
          const s = shots[i];
          s.style.transform = `translateX(${slide.toFixed(2)}px) scale(${(0.7 + 0.3 * prox).toFixed(4)})`;
          s.style.opacity = (0.3 + 0.7 * prox).toFixed(3);
          s.style.filter = `saturate(${(0.45 + 0.55 * prox).toFixed(3)})`;
          s.style.zIndex = String(Math.round(prox * 10));
          if (Math.abs(d) < best) { best = Math.abs(d); nearest = i; }
        });

        if (nearest !== active) {
          items.forEach((it, i) => it.classList.toggle('is-active', i === nearest));
          active = nearest;
        }
      };

      const onScroll = () => {
        if (!pinnable() || pinFrame) return;
        pinFrame = requestAnimationFrame(() => { pinFrame = 0; pinLayout(); });
      };

      const setPinned = () => {
        if (pinnable()) {
          // Runway: one screenful to settle, then a screenful-ish per shot.
          scroller.style.height = `calc(100svh + ${(items.length - 1) * 62}svh)`;
          section.classList.add('dock--pinned');
          pinLayout();
        } else {
          section.classList.remove('dock--pinned');
          scroller.style.height = '';
          reset();
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { setPinned(); onScroll(); });

      const sync = () => { setPinned(); if (!on()) reset(); };
      fine.addEventListener('change', sync);
      wide.addEventListener('change', sync);
      still.addEventListener('change', sync);
      small.addEventListener('change', sync);

      dock.classList.add('dock--js');
      setPinned();
    })();
  </script>

  <h2 class="home-section-title">Explore</h2>
  {# Three signpost cards, sharing the blog listing's card styles so the home
     page and /blog/ read as one system. Edit the copy here, not in CSS. #}
  <div class="post-grid home-links">
    <a href="{{ '/blog/' | url }}" class="post-card">
      <div class="post-card-img">
        <img src="{{ '/static/images/open-bat-blog-screenshot.webp' | url }}" alt="" loading="lazy">
      </div>
      <div class="post-card-body">
        <h2>Blog</h2>
        <div class="post-card-meta"><span class="tag">writing</span></div>
        <p class="post-card-desc">How the app works, what we are building next, and what we are learning about bats along the way.</p>
      </div>
    </a>

    <a href="{{ '/contribute/' | url }}" class="post-card">
      <div class="post-card-img">
        <img src="{{ '/static/images/guide-editor-list.webp' | url }}" alt="" loading="lazy">
      </div>
      <div class="post-card-body">
        <h2>Contribute</h2>
        <div class="post-card-meta"><span class="tag">community</span></div>
        <p class="post-card-desc">The field guide is written by people who know their local bats. Add a species, correct a detail, or help test the app.</p>
      </div>
    </a>

    <a href="{{ '/download-openbat/' | url }}" class="post-card">
      <div class="post-card-img">
        <img src="{{ '/static/images/OpenBat_Screens.webp' | url }}" alt="" loading="lazy">
      </div>
      <div class="post-card-body">
        <h2>Download</h2>
        <div class="post-card-meta"><span class="tag">coming soon</span></div>
        <p class="post-card-desc">OpenBat is heading to the App Store. This is where the download link will live — check back shortly.</p>
      </div>
    </a>
  </div>

  <h2 class="home-section-title">Our Story</h2>
  <div class="home-card">
    <div class="post-content">{{ content | safe }}</div>
  </div>
  {% if 'gallery-start' in content %}<script src="{{ '/static/js/swiper-bundle.min.js' | url }}"></script>{% endif %}
</div>
