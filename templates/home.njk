---
layout: base.njk
---
{% block head %}
{% if 'gallery-start' in content %}<link rel="stylesheet" href="{{ '/static/css/swiper-bundle.min.css' | url }}"/>{% endif %}
{% endblock %}
{# Optional dark hero; without heroTitle/heroImage the page keeps the plain
   page.njk header instead. #}
{% if heroTitle or heroImage %}
<div class="hero-plain">
  {% if heroImage %}
  <img src="{{ heroImage }}" alt="" class="hero-plain-bg">
  {% endif %}
  <div class="hero-plain-inner">
    <h1 class="hero-plain-title">{{ heroTitle | default(title) }}</h1>
    {% if heroText %}<p class="hero-plain-text">{{ heroText }}</p>{% endif %}
    {% if heroCtaUrl %}
    <a class="hero-plain-cta" href="{{ heroCtaUrl | url }}">{{ heroCtaLabel | default("Learn more") }}</a>
    {% endif %}
  </div>
</div>
{% endif %}

<div class="standard-page">
  {% if not (heroTitle or heroImage) and title %}
  <div class="listing-header listing-header--home">
    <h1>{{ title }}</h1>
    {% if description %}<p class="page-lead">{{ description }}</p>{% endif %}
  </div>
  {% endif %}

  {# The same featured ticker that heads /blog/, sitting under the page title.
     Both read collections.heroPosts and share the ticker markup/script in
     base.njk — keep the two in step. #}
  {% set hero = collections.heroPosts %}
  {% if hero.length %}
  <div class="home-featured">
    {% include "partials/hero-ticker.njk" %}
  </div>
  {% endif %}

  <h2 class="home-section-title">The App</h2>
  {% include "partials/app-dock.njk" %}

  <h2 class="home-section-title">Explore</h2>
  {# Three signpost cards, sharing the blog listing's card styles so the home
     page and /blog/ read as one system. Edit the copy here, not in CSS. #}
  <div class="post-grid home-links">
    <a href="{{ '/blog/' | url }}" class="post-card">
      <div class="post-card-img">
        <img src="{{ '/static/images/open-bat-blog-screenshot.webp' | url }}" alt="" loading="lazy">
      </div>
      <div class="post-card-body">
        <h2>Blog</h2>
        <div class="post-card-meta"><span class="tag">writing</span></div>
        <p class="post-card-desc">How the app works, what we are building next, and what we are learning about bats along the way.</p>
      </div>
    </a>

    <a href="{{ '/contribute/' | url }}" class="post-card">
      <div class="post-card-img">
        <img src="{{ '/static/images/guide-editor-list.webp' | url }}" alt="" loading="lazy">
      </div>
      <div class="post-card-body">
        <h2>Contribute</h2>
        <div class="post-card-meta"><span class="tag">community</span></div>
        <p class="post-card-desc">The field guide is written by people who know their local bats. Add a species, correct a detail, or help test the app.</p>
      </div>
    </a>

    <a href="{{ '/download/' | url }}" class="post-card">
      <div class="post-card-img">
        <img src="{{ '/static/images/OpenBat_Screens.webp' | url }}" alt="" loading="lazy">
      </div>
      <div class="post-card-body">
        <h2>Download Now!</h2>
        <div class="post-card-meta"><span class="tag">out now</span></div>
        <p class="post-card-desc">OpenBat is on the App Store. Detect, record and identify bats from your iPhone — free, and open source.</p>
      </div>
    </a>
  </div>

  <h2 class="home-section-title">Our Story</h2>
  <div class="home-card">
    <div class="post-content">{{ content | safe }}</div>
  </div>
  {# The newest posts, as the same cards /blog/ uses. The collection excludes
     whatever the ticker above is showing, so nothing appears twice. #}
  {% if collections.recentPosts.length %}
  <div class="home-section-head">
    <h2 class="home-section-title">Recent Posts</h2>
    <a class="home-section-link" href="{{ '/blog/' | url }}">All posts <span aria-hidden="true">&rarr;</span></a>
  </div>
  <div class="post-grid home-recent">
    {% for post in collections.recentPosts %}
    <a href="{{ post.url | url }}" class="post-card">
      {% if post.data.coverImage %}
      <div class="post-card-img">
        <img src="{{ post.data.coverImage }}" alt="" loading="lazy">
      </div>
      {% endif %}
      <div class="post-card-body">
        <h2>{{ post.data.title }}</h2>
        <div class="post-card-meta">
          {% if post.date %}<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>{% endif %}
          {% for tag in post.data.tags | limit(2) %}<span class="tag">{{ tag }}</span>{% endfor %}
        </div>
        <p class="post-card-desc">{{ post.data.excerpt | default(post.data.description) | default(post.templateContent | autoExcerpt) }}</p>
      </div>
    </a>
    {% endfor %}
  </div>
  {% endif %}

  {% if 'gallery-start' in content %}<script src="{{ '/static/js/swiper-bundle.min.js' | url }}"></script>{% endif %}
</div>
