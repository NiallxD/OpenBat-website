---
layout: base.njk
---
{% block head %}
{% if 'gallery-start' in content %}<link rel="stylesheet" href="{{ '/static/css/swiper-bundle.min.css' | url }}"/>{% endif %}
{% endblock %}
{% set hero = heroImage | default(coverImage) %}

{% if hero %}
{# Full-bleed hero: the image runs under the transparent nav, with the title,
   standfirst and meta sitting on it. Without an image the post falls back to
   the plain header below, so a post never has to have one. #}
<div class="post-hero{% if tileHero %} post-hero--tiled{% endif %}">
  {% if tileHero %}
  {# tileHero: true repeats the one image across a rotated plane instead of
     stretching it. Alternate rows slide half a tile sideways so the seams
     never line up into an obvious grid. Purely decorative, so the whole plane
     is hidden from assistive tech and every tile has an empty alt. The plane
     is deliberately larger than the hero: rotating a box leaves triangular
     corners uncovered, and the overflow is clipped by .post-hero. #}
  <div class="post-hero-tiles" aria-hidden="true"
       style="--tile-w: {{ tileHeroWidth | default('460px') }}; --tile-angle: {{ tileHeroAngle | default(30) }}deg; --tile-gap: {{ tileHeroGap | default('12px') }}; --tile-blur: {{ tileHeroBlur | default('3px') }}">
    {% for row in range(0, tileHeroRows | default(12)) %}
    <div class="post-hero-tile-row">
      {% for col in range(0, tileHeroCols | default(8)) %}<img src="{{ hero }}" alt="" decoding="async">{% endfor %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <img class="post-hero-bg" src="{{ hero }}" alt="">
  {% endif %}
  <div class="post-hero-shade"></div>
  <div class="post-hero-inner">
    <p class="section-label"><a href="{{ '/blog/' | url }}" class="post-back">← Blog</a></p>
    <h1>{{ title }}</h1>
    {% if description %}<p class="post-hero-text">{{ description }}</p>{% endif %}
    <div class="post-meta">
      {% if date %}<time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% endif %}
      {% if author %}<span class="post-author">{{ author }}</span>{% endif %}
      {% for tag in tags %}<span class="tag">{{ tag }}</span>{% endfor %}
    </div>
  </div>
</div>
{% endif %}

<article class="standard-page post{% if hero %} post--hero{% endif %}">
  {% if not hero %}
  <header class="post-header">
    <p class="section-label"><a href="{{ '/blog/' | url }}" class="post-back">← Blog</a></p>
    <h1>{{ title }}</h1>
    {% if description %}<p class="page-lead">{{ description }}</p>{% endif %}
    <div class="post-meta">
      {% if date %}<time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% endif %}
      {% if author %}<span class="post-author">{{ author }}</span>{% endif %}
      {% for tag in tags %}<span class="tag">{{ tag }}</span>{% endfor %}
    </div>
  </header>
  {% endif %}

  <div class="post-content">{{ content | safe }}</div>
  {% if 'gallery-start' in content %}<script src="{{ '/static/js/swiper-bundle.min.js' | url }}"></script>{% endif %}

  {% set related = collections.posts | relatedPosts(page.url, tags) %}
  {% if related.length %}
  <div class="post-related">
    <p class="section-label">Read more</p>
    <div class="post-grid">
      {% for post in related %}
      <a href="{{ post.url | url }}" class="post-card">
        {% if post.data.coverImage %}
        <div class="post-card-img">
          <img src="{{ post.data.coverImage }}" alt="" loading="lazy">
        </div>
        {% endif %}
        <div class="post-card-body">
          <h2>{{ post.data.title }}</h2>
          <div class="post-card-meta">
            {% if post.date %}<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>{% endif %}
          </div>
          <p class="post-card-desc">{{ post.data.excerpt | default(post.data.description) | default(post.templateContent | autoExcerpt) }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</article>
